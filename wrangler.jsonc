{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portme",
  "main": "api/src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "carloselandro.com.br", "custom_domain": true },
    { "pattern": "www.carloselandro.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 2, "period": 60 }
    }
  ],
  "vars": {
    "CONTACT_TO": "c.elandro.bp@gmail.com",
    "CONTACT_FROM": "onboarding@resend.dev"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
